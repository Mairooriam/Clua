{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 19,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "D:/DevTools/MYSYS2/mingw64"
      }
    },
    {
      "name": "msvc-debug",
      "inherits": "base",
      "description": "MSVC Debug Build",
      "binaryDir": "${sourceDir}/build/msvc-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "clangd-debug",
      "inherits": "base",
      "description": "Clangd Debug Build (for clangd language server)",
      "binaryDir": "${sourceDir}/build/clangd-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "msvc-release",
      "inherits": "base",
      "description": "MSVC Release Build",
      "binaryDir": "${sourceDir}/build/msvc-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "mingw-debug",
      "inherits": "base",
      "description": "MinGW Debug Build",
      "binaryDir": "${sourceDir}/build/mingw-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "mingw-release",
      "inherits": "base",
      "description": "MinGW Release Build",
      "binaryDir": "${sourceDir}/build/mingw-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "clang-debug",
      "inherits": "base",
      "description": "Clang-cl Debug Build",
      "binaryDir": "${sourceDir}/build/clang-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl"
      }
    },
    {
      "name": "clang-release",
      "inherits": "base",
      "description": "Clang-cl Release Build",
      "binaryDir": "${sourceDir}/build/clang-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "msvc-debug-build",
      "configurePreset": "msvc-debug"
    },
    {
      "name": "msvc-release-build",
      "configurePreset": "msvc-release"
    },
    {
      "name": "mingw-debug-build",
      "configurePreset": "mingw-debug"
    },
    {
      "name": "mingw-release-build",
      "configurePreset": "mingw-release"
    },
    {
      "name": "clang-debug-build",
      "configurePreset": "clang-debug"
    },
    {
      "name": "clang-release-build",
      "configurePreset": "clang-release"
    }
  ]
}